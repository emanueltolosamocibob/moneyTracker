# --- Frontend (Vite, público) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend (funciones de Vercel, secreto) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Header Authorization que debe mandar el cron para poder llamar
# /api/cron/scan-gmail. Generar con: openssl rand -hex 32
CRON_SECRET=

# Necesario solo si NO se despliega en Vercel (Vercel AI Gateway se
# autentica solo vía OIDC en producción/preview).
# AI_GATEWAY_API_KEY=

# categorize.ts llama a Gemini directo (no vía AI Gateway) para evitar el
# rate limit del free tier de Gateway. Conseguir una key gratis en
# https://aistudio.google.com -> "Get API key".
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Alertas de Telegram (Inversiones) ---
# MTProto, no Bot API — ver la nota en CLAUDE.md sobre por qué. api_id/hash
# salen de https://my.telegram.org. TELEGRAM_SESSION y el id del canal
# (TELEGRAM_CHAT_ID) los genera scripts/telegram-login.mjs, una sola vez.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHAT_ID=

# --- Paper trading sobre esas mismas alertas ---
# Secreto compartido entre el listener local (scripts/telegram-paper-listener.mjs)
# y /api/paper/ingest-message. Generar con: openssl rand -hex 32. Va en los
# dos lados: acá (Vercel) y en el .env.local de la máquina que corre el
# listener.
TELEGRAM_INGEST_SECRET=

# --- Solo para la máquina que corre el listener (NO van a Vercel) ---
# PAPER_INGEST_URL=https://<tu-app>.vercel.app/api/paper/ingest-message
# PAPER_USER_ID=
